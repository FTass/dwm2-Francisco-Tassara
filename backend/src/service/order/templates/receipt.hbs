<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Boleta {{orderNumber}}</title>
</head>
<body class="p-5">
    <div class="container">
        <h1 class="text-center mb-4">BOLETA ELECTRÓNICA</h1>
        
        <div class="row mb-3">
            <div class="col-6">
                <p><strong>Boleta Nº:</strong> {{orderNumber}}</p>
                <p><strong>Fecha:</strong> {{date}}</p>
            </div>
            <div class="col-6 text-end">
                <h5>Queso & Sabor</h5>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h5>Cliente</h5>
                <p><strong>Nombre:</strong> {{user.firstName}} {{user.lastName}}</p>
                <p><strong>Dirección:</strong> {{address.street}} {{address.number}}</p>
            </div>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each items}}
                <tr>
                    <td>{{ this.productId.name}}</td>
                    <td>{{ this.quantity}}</td>
                    <td>${{this.unitPrice}}</td>
                    <td>${{this.subTotal}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <div class="text-end">
            <p><strong>Subtotal:</strong> ${{subTotal}}</p>
            <p><strong>Impuestos:</strong> ${{tax}}</p>
            <h5><strong>TOTAL:</strong> ${{total}}</h5>
        </div>
    </div>
</body>
</html>